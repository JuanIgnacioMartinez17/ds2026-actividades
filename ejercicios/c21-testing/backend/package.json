{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --ignore src/generated src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:push": "prisma generate && prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "npm run db:push && npm run db:seed",
    "test": "vitest run --exclude src/**/*.db.test.ts",
    "test:watch": "vitest --exclude src/**/*.db.test.ts",
    "test:db": "vitest run src/routes/auth.routes.db.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.2",
    "nodemon": "^3.1.14",
    "prisma": "^7.9.1",
    "tsx": "^4.23.9",
    "typescript": "^7.0.2",
    "vitest": "^4.0.0",
    "supertest": "^7.1.4",
    "@types/supertest": "^6.0.3"
  }
}
